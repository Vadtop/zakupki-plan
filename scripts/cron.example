# Пример для Linux/macOS: пересчёт плана каждый день в 07:00.
# Добавить в crontab:  crontab -e  и вставить строки ниже, поправив путь к проекту.
# DATA_DATE — дата расчёта («сегодня» = дата выгрузки, ГГГГ-ММ-ДД), передаётся в --today;
# обновлять вместе с выгрузкой. Пустая — дата из последнего заказа/прихода и предупреждение в журнале.
DATA_DATE=2026-08-13
0 7 * * * cd /путь/к/проекту && mkdir -p out && python3 -m zakupki run --data data/raw/share ${DATA_DATE:+--today "$DATA_DATE"} >> out/run_daily.log 2>&1
